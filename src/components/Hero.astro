---
// Full-width hero with looping reel background — plays on mobile too now,
// using a separate lower-res/bitrate file (see public/hero-reel-mobile.mp4)
// so mobile never fetches the full desktop file. .hero-bg + the poster image
// remain the fallback shown while the video loads, or if autoplay is
// blocked outright (see the play().catch() below).
//
// The video source is picked in JS (below), not via <source media="">.
// iOS Safari has a long history of unreliably honoring the media attribute
// on <source> elements inside <video> — unlike <picture>, where it's solid.
// Setting .src directly is the robust, widely-recommended workaround, and
// since the element starts with no src/source at all, nothing is fetched
// until that script runs, so there's no risk of double-loading.
//
// Mobile keeps the original background-video structure (text overlaid on
// top, same as desktop) — just a shorter hero box with the video letterboxed
// via object-fit: contain instead of cover, so it keeps its full 16:9 frame
// with no cropping. See the mobile HERO rules in global.css.
//
// Accessibility (WCAG 2.2.2): the reel loops indefinitely, so a pause/play
// button sits in the bottom-right corner. Visitors with
// prefers-reduced-motion get the reel loaded but paused on its first frame.
---
<link rel="preload" as="image" href="/hero-poster.jpg" media="(max-width: 768px)" />
<section class="hero">
  <div class="hero-bg"></div>
  <video
    class="hero-video"
    id="heroVideo"
    autoplay muted loop playsinline
    preload="auto"
  ></video>
  <div class="hero-overlay"></div>
  <div class="hero-fade"></div>

  <div class="hero-content">
    <div class="hero-eyebrow">Filmmaker</div>
    <h1>
      <span class="visually-hidden">Eliya Kapach</span>
      <img class="hero-wordmark" src="/brand/eliya-wordmark.png" alt="" width="1240" height="243" fetchpriority="high" />
    </h1>
    <p class="hero-available"><span>[</span> Available worldwide <span>]</span></p>
    <div class="hero-buttons">
      <a href="#films" class="hero-btn primary">See Work</a>
      <a href="#contact" class="hero-btn">Let's Create</a>
    </div>
  </div>

  <button type="button" class="hero-video-toggle" id="heroVideoToggle" aria-label="Pause background video">
    <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h3v14H7zM14 5h3v14h-3z"/></svg>
    <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
  </button>

  <div class="hero-border"></div>
</section>

<script>
  const video = document.getElementById('heroVideo') as HTMLVideoElement | null;
  const toggle = document.getElementById('heroVideoToggle');
  if (video) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Set by the toggle (or reduced motion) so the autoplay fallback below
    // never restarts a reel the visitor chose to stop.
    let userPaused = reduceMotion;
    if (reduceMotion) video.autoplay = false;

    // Pick the source once, up front — deliberately not re-checked on
    // resize, matching how <source media=""> would have behaved anyway
    // (browsers only reconsider it on an explicit .load() call).
    const isMobile = window.matchMedia('(max-width: 768px)').matches;
    video.src = isMobile ? '/hero-reel-mobile.mp4' : '/HERO-REELcomp.mp4';

    const showVideo = () => video.classList.add('loaded');
    video.addEventListener('canplay', showVideo);
    video.addEventListener('loadeddata', showVideo);
    if (video.readyState >= 3) showVideo();
    const syncToggle = () => {
      if (!toggle) return;
      const paused = video.paused;
      toggle.classList.toggle('is-paused', paused);
      toggle.setAttribute('aria-label', paused ? 'Play background video' : 'Pause background video');
    };
    video.addEventListener('play', syncToggle);
    video.addEventListener('pause', syncToggle);

    toggle?.addEventListener('click', () => {
      if (video.paused) {
        userPaused = false;
        video.play().catch(() => {});
      } else {
        userPaused = true;
        video.pause();
      }
    });

    if (!reduceMotion) {
      video.play().catch(() => {
        document.addEventListener('touchstart', () => {
          if (!userPaused) video.play();
        }, { once: true });
      });
    }
    syncToggle();
  }
</script>
