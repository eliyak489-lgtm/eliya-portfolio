---
// Full projects index grid with category tabs (used on /work). Filtering
// logic mirrors FilmGrid's, scoped to the four Category4 values instead of
// the legacy viral/travel/commercial tabs.
import { projects } from '../data/projects.ts';
import { categories } from '../data/categories.ts';
import ProjectCard from './ProjectCard.astro';
import VerticalFilms from './VerticalFilms.astro';

const landscape = projects.filter((p) => !p.vertical);
const verticals = projects.filter((p) => p.vertical);
---
<section class="films-section">
  <div class="films-header">
    <div>
      <h2 class="section-title">All Projects</h2>
    </div>
    <span class="films-count">{landscape.length} Projects</span>
  </div>

  <div class="films-tabs">
    <button class="tab-btn active" data-filter="all">All</button>
    {categories.map((cat) => (
      <button class="tab-btn" data-filter={cat.slug}>{cat.title}</button>
    ))}
  </div>

  <div class="films-grid" id="projectsGrid">
    {landscape.map((project) => <ProjectCard project={project} />)}
  </div>
</section>

<VerticalFilms items={verticals} id="verticalGrid" />

<script>
  const grid = document.getElementById('projectsGrid');
  const verticalGrid = document.getElementById('verticalGrid');
  const verticalBand = verticalGrid?.closest<HTMLElement>('.films-section') ?? null;
  const tabs = grid?.closest('.films-section')?.querySelector<HTMLElement>('.films-tabs');

  if (grid && tabs) {
    tabs.addEventListener('click', (e) => {
      const target = e.target as Element | null;
      const btn = target?.closest<HTMLElement>('.tab-btn');
      if (!btn) return;
      const category = btn.dataset.filter;

      tabs.querySelectorAll('.tab-btn').forEach((t) => t.classList.remove('active'));
      btn.classList.add('active');

      // The vertical band follows the same filter; hide it when it has no match.
      if (verticalGrid && verticalBand) {
        const anyVertical = Array.from(verticalGrid.querySelectorAll<HTMLElement>('.film-card'))
          .some((card) => category === 'all' || card.dataset.category === category);
        verticalBand.hidden = !anyVertical;
      }

      const cards = [grid, verticalGrid].flatMap((g) =>
        g ? Array.from(g.querySelectorAll<HTMLElement>('.film-card')) : []);
      cards.forEach((card) => {
        const show = category === 'all' || card.dataset.category === category;
        card.style.opacity = '0';
        card.style.transform = 'translateY(12px)';
        setTimeout(() => {
          card.style.display = show ? '' : 'none';
          if (show) {
            requestAnimationFrame(() => {
              card.style.transition = 'opacity 0.35s ease, transform 0.35s ease';
              card.style.opacity = '1';
              card.style.transform = '';
            });
          }
        }, 80);
      });
    });
  }
</script>
