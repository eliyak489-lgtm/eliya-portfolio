---
// Global YouTube lightbox. Opens when any element with [data-video-id] is
// clicked or activated with Enter/Space (e.g. a FilmCard). Triggers with
// [data-vertical] open a 9:16 player. Rendered once per
// page via BaseLayout. While open, the rest of the page is made `inert` so
// focus stays in the dialog; on close, focus returns to the trigger.
---
<div class="modal-overlay" id="modal" role="dialog" aria-modal="true" aria-label="Video player">
  <div class="modal-video">
    <button type="button" class="modal-close" aria-label="Close video">
      <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
    <iframe id="modal-iframe" src="" title="Video player" frameborder="0"
      allow="autoplay; encrypted-media; fullscreen"
      allowfullscreen></iframe>
  </div>
</div>

<script>
  const modal = document.getElementById('modal');
  const iframe = document.getElementById('modal-iframe') as HTMLIFrameElement | null;
  const closeBtn = modal?.querySelector<HTMLButtonElement>('.modal-close') ?? null;
  const frame = modal?.querySelector<HTMLElement>('.modal-video') ?? null;
  let lastTrigger: HTMLElement | null = null;

  const isOpen = () => !!modal?.classList.contains('open');

  // Everything on the page except the modal itself.
  const backgroundEls = () =>
    Array.from(document.body.children).filter((el) => el !== modal) as HTMLElement[];

  function openModal(videoId: string, trigger: HTMLElement) {
    if (!modal || !iframe) return;
    lastTrigger = trigger;
    iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1`;
    // Vertical videos (data-vertical) play in a 9:16 frame instead of 16:9.
    frame?.classList.toggle('is-vertical', trigger.hasAttribute('data-vertical'));
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
    backgroundEls().forEach((el) => { el.inert = true; });
    closeBtn?.focus();
  }

  function closeModal() {
    if (!modal || !iframe || !isOpen()) return;
    modal.classList.remove('open');
    iframe.src = '';
    document.body.style.overflow = '';
    backgroundEls().forEach((el) => { el.inert = false; });
    lastTrigger?.focus();
    lastTrigger = null;
  }

  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    if (!target) return;
    const trigger = target.closest<HTMLElement>('[data-video-id]');
    if (trigger?.dataset.videoId) { openModal(trigger.dataset.videoId, trigger); return; }
    if (target === modal || target.closest('.modal-close')) closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { closeModal(); return; }

    // The cards are role="button" divs, so give them native button keys.
    if (e.key === 'Enter' || e.key === ' ') {
      const trigger = (e.target as Element | null)?.closest<HTMLElement>('[data-video-id]');
      if (trigger?.dataset.videoId && trigger === e.target) {
        e.preventDefault();
        openModal(trigger.dataset.videoId, trigger);
      }
      return;
    }

    // Keep Tab cycling between the close button and the player.
    if (e.key === 'Tab' && isOpen() && closeBtn && iframe) {
      if (e.shiftKey && document.activeElement === closeBtn) {
        e.preventDefault();
        iframe.focus();
      }
    }
  });

  // Fallback trap: if focus ever lands outside the open dialog, bring it back.
  document.addEventListener('focusin', (e) => {
    if (isOpen() && modal && !modal.contains(e.target as Node)) closeBtn?.focus();
  });
</script>
